# Local Ollama model name (e.g. llama3.2, mistral, qwen2.5)
OLLAMA_MODEL=llama3.2

# GitHub personal access token (OPTIONAL)
# - Omit or leave empty for read-only mode: Review and Improve (public repos) work; Draft produces copyable text—create issues/PRs manually.
# - When set (scope: repo): you can create issues/PRs from the UI after approval.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub repo in owner/name format (or use repo field in Improve form / GitHub URL)
GITHUB_REPO=owner/repo-name

# Absolute path to local git repository (for git diff and file reads)
REPO_PATH=/path/to/your/repo

# Optional: Ollama base URL (default http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Agentic Protocols
# ---------------------------------------------------------------------------

# Base URL of this FastAPI app (used in A2A agent-card "url" fields).
# Override when deploying behind a reverse proxy or at a custom hostname/port.
# A2A_BASE_URL=http://localhost:8000
